# Copy this file to .env and fill in real values

# Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg2://saras:saras_password@localhost:5432/saras_ai

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# NOTE: RAG / LLM (Claude API, embeddings, pgvector) are intentionally
# excluded from this prototype build. No ANTHROPIC_API_KEY is needed.
